# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored so your secrets stay on your machine.

# --- AWS Bedrock (the reasoning brain) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Amazon Nova via the APAC inference profile (works in ap-south-1 / Mumbai):
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# --- Web search ---
USE_WEB_SEARCH=true

# --- Voice / speech ---
VOICE_GENDER=female        # female or male
SPEECH_RATE=175            # words per minute
LISTEN_SECONDS=7           # seconds to wait for you to start speaking
PHRASE_LIMIT_SECONDS=20    # max length of a single spoken command
PAUSE_THRESHOLD=0.9        # seconds of silence that ends your phrase
